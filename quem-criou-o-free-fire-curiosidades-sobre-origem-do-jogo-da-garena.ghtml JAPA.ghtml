                      });
                      if (!hasViewEvent) {
                        window.dataLayer.push({ event: 'eventGen', nomeEvento: 'materia_botao_continuar_lendo_exibicao' });
                      } else {
                        console.log('[SEE-MORE][TRACKING] Evento de view já existia; pulando push');
                      }
                    } catch (e) {
                      console.error('[SEE-MORE][TRACKING] Erro ao rastrear view:', e);
                    }
                    pendingViewTracking = false;
                  }
                });

                waitUserAuth(function (logadoStr) {
                  const logadoBoolean = ("techtudo" == 'oglobo') ? logadoStr === 'true' : false;
                  if (!logadoBoolean && isPercent) {
                    isLoaded = true;
                  }

                  article.classList.add('ready');

                  if ('listas' === 'especial') {
                    article.classList.remove('cropped');
                  } else {
                    if (logadoBoolean) {
                      article.classList.remove('cropped');
                    } else {
                      if (isPercent) {
                        article.classList.add('cropped');
                        if (isLoaded && isInWhiteCategory) {
                          // Evento de carregamento do botão (quando o botão já está presente na página)
                          try {
                            window.dataLayer = window.dataLayer || [];
                            var hasLoadedEvent = (window.dataLayer || []).some(function (item) {
                              return item && item.nomeEvento === 'materia_botao_continuar_lendo_carregado';
                            });

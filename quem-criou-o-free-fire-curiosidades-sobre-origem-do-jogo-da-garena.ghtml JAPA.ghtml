                if (article) {
                  obs.disconnect();
                  init(article);
                }
              });

              observer.observe(document.body, {
                childList: true,
                subtree: true
              });

            } catch (e) {
              console.error('[SEE-MORE] Erro no script:', e);
            }
          })();

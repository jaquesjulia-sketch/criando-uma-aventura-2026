                          }
                        }

                      } else {
                        article.classList.remove('cropped');
                      }
                    }
                  }
                  
                  if (readMoreBtn) {
                    // Evento de clique
                    readMoreBtn.addEventListener(
                      'click',
                      function () {
                        readMoreBtn.textContent = 'Carregando...';
                        // Integração com rastreamento de eventos
                        try {
                          eventClick = true;
                          if (clearForAdsReady) {
